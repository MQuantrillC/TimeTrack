# Neon Postgres connection string.
#
# On Vercel: Storage → Create Database → Neon. The integration injects this
# variable into the deployment automatically, so you do not need to set it there.
#
# For local development, copy this file to .env.local and paste the connection
# string from the Neon dashboard (or `vercel env pull`).
#
# Without it the app still runs — it simply keeps data in the browser and the
# sync panel reports that no database is configured.
DATABASE_URL=
